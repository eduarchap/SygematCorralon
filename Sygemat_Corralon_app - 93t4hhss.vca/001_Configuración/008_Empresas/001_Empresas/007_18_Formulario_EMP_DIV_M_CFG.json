Plano_34":false,"Posición X_3":250,"Posición Y_4":0,"Prefijo_84":"","Seleccionable con Tab_6":true,"Solo lectura_9":"","Sufijo_85":"","Tabla apuntada_89":"","Tamaño de icono_39":0,"Tamaño del borde_11":0,"Tecla aceleradora_28":0,"Texto visible_35":false,"Tipo de botones_83":0,"Tipo de espaciador_71":0,"Tipo de layout_65":0,"Tipo de menú de botón_76":0,"Tipo de menú de contexto_74":1,"Tipo_0":28,"ToolTip_5":{},"Valor crítico_79":0,"Valor incremento_80":0,"Valor nominal_78":0,"Valor_14":"","Vista de datos de lista_87":""},"style":0,"type":19},{"comments":"","id":"MEN_CFG_CHG_SEL","magicNumber":4014,"magicVer":2,"names":{"es":"Cambio el elemento seleccionado"},"properties":{"Acción disparada_2":"","Control_0":"MEN_CFG","Manejador de evento_3":"CAR_FRM_SEL","Señal_1":10},"style":0,"type":37},{"comments":"","id":"POS_INI","magicNumber":4014,"magicVer":2,"names":{},"properties":{"Acción disparada_2":"","Control_0":"","Manejador de evento_3":"POS_INI","Señal_1":11},"style":0,"type":37},{"comments":"","id":"CAR_FRM_SEL","magicNumber":3759,"magicVer":1,"names":{"es":"Cargar el formulario seleccionado"},"properties":{"Lenguaje_0":1,"Script_1":"// --------------------------------\n// Abrir el formulario seleccionado\n// --------------------------------\nvar controlListBox = theRoot.dataView().control(\"MEN_CFG\");\nvar controlPila = theRoot.dataView().control(\"FRM_CFG\");\ncontrolPila.removeForm(0);\nvar formulario = controlPila.addForm(controlListBox.itemData(controlListBox.currentRow));\nformulario.updateControls();\n"},"style":0,"type":38},{"comments":"","id":"CAR_LIS_BOX","magicNumber":3759,"magicVer":1,"names":{"es":"Cargar el listbox con los subformularios"},"properties":{"Lenguaje_0":1,"Script_1":"// ---------------------------------------------------------------------------------------------------------\n// Carga el listbox con los formularios no privados que tengan el mismo prefijo que el formulario contenedor\n// ---------------------------------------------------------------------------------------------------------\nimportClass(\"VImage\");\n\n\n// ----------------------------------------\n// Devuelve el icono asociado al formulario\n// ----------------------------------------\nvar iconoFormulario = function (proyectoId, formularioId)\n{\n\tvar formularioInfo = theApp.projectInfo(proyectoId).objectInfo(VObjectInfo.TypeForm, formularioId);\n\tif (formularioInfo)\n\t{\n\t\tvar icono = new VImage();\n\t\tvar iconoIdRef = formularioInfo.propertyData(6).replace( \"@\", \"/\" );\n\t\tif ( \"\" !== iconoIdRef )\n\t\t{\n\t\t\t// retornamos el icono\n\t\t\ticono.loadResource( iconoIdRef );\n\t\t\treturn icono;\n\t\t}\n\t\telse\n\t\t{\n\t\t\t// Si no tiene icono asignado devolvemos undefined\n\t\t\treturn undefined;\n\t\t}\n\t}\n}\n\n\n// ----------------------------------------------------------------------\n// Preparamos el icono por defecto por si no tiene icono el subformulario\n// ----------------------------------------------------------------------\nvar formularioContenedorInfo = theRoot.dataView().objectInfo();\niconoDefecto = iconoFormulario( formularioContenedorInfo.idRef().split( \"/\" )[0], formularioContenedorInfo.id() );\n\n// Si el formulario contenedor no tiene asignado icono se asume el de configuración\nif ( undefined === iconoDefecto )\n{\n\ticonoDefecto = new VImage();\n\ticonoDefecto.loadResource( \"sygemat_corralon_app/CFG\" );\n}\n\n\n// ------------------------------------------------------------------------------------------\n// Preparamos los controles del formulario: la pila de formularios y el listbox que limpiamos\n// ------------------------------------------------------------------------------------------\nvar controlPila = theRoot.dataView().control( \"FRM_CFG\" );\nvar controlListBox = theRoot.dataView().control( \"MEN_CFG\" );\ncontrolListBox.sortingEnabled = true;\ncontrolListBox.clear();\n\n\n// -------------------------------------------------------------------------------------\n// Leemos todos los formularios que tengan en el ID el prefijo del formulario contenedor\n// -------------------------------------------------------------------------------------\n\n// Obtenemos el ID del formulario contenedor para preparar el prefijo a buscar\nvar prefijo = formularioContenedorInfo.id() + \"_\";\n\nvar proyectoPrincipal = theApp.mainProjectInfo();\nvar numeroFormularios = proyectoPrincipal.allObjectCount( VObjectInfo.TypeForm );\n\nfor ( var numeroFormulario = 0; numeroFormulario < numeroFormularios; numeroFormulario++ )\n{\n\tvar formularioInfo = proyectoPrincipal.allObjectInfo( VObjectInfo.TypeForm, numeroFormulario );\n\t\n\t// Si el formulario tiene el mismo prefijo y no es privado se añade al listbox\n\tif ( ( 0 === formularioInfo.id().indexOf( prefijo ) ) && ( false === formularioInfo.isPrivate() ) )\n\t{\t\n\t\t// Si el subformulario tiene icono asignado se usa, en caso contrario se usa el del formulario contenedor\n\t\tvar iconoLista = iconoFormulario( formularioInfo.idRef().split( \"/\" )[0], formularioInfo.id() );\n\t\tif ( undefined === iconoLista ) { iconoLista = iconoDefecto };\n\n\t\t// Se añade el subformulario a la lista\n\t\tcontrolListBox.addItem( iconoLista, formularioInfo.name(), formularioInfo.idRef() );\n\t}\n}\n\n\n// ---------------------------------------------\n// Marcamos el primer elemento como seleccionado\n// ---------------------------------------------\ncontrolListBox.currentRow = controlPila.currentIndex;\n"},"style":0,"type":38},{"comments":"","id":"POS_INI","magicNumber":3759,"magicVer":1,"names":{},"properties":{"Lenguaje_0":0,"Script_1":""},"style":0,"subobjects":[{"comments":"","id":"3","magicNumber":37900,"magicVer":0,"names":{},"properties":{"Comando_0":23,"Desactivada_7":true,"Parámetro 1_1":"Cargar lista de subformularios","Parámetro 2_2":"","Parámetro 3_3":"","Parámetro 4_4":"","Parámetro 5_5":"","Parámetro 6_6":""},"style":0,"type":39},{"comments":"","id":"5","magicNumber":37900,"magicVer":0,"names":{},"properties":{"Coman