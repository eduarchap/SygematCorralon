fo[numProyecto].alias());\n};\n\ncontrolProyecto.setCurrentIndex(controlProyecto.findData(theRegisterIn.fieldToString(\"PRO_PRT_PRY\")));\n"},"style":0,"type":38},{"comments":"","id":"COM_BOX_TO_CAM","magicNumber":3759,"magicVer":1,"names":{"es":"Pasar datos de combobox a campos"},"properties":{"Lenguaje_0":1,"Script_1":"// -----------------------------------------------\n// Pasar el valor de los combobox a campos\n// -----------------------------------------------\n\n// Atrapar el formulario donde están los controles\nvar formulario = theRoot.dataView();\n\n// Proyecto del proceso de emisión\nvar control = formulario.control(\"PRO_PRT_PRY\");\nif (control.itemData(control.currentIndex))\n{\n\ttheRegisterIn.setField(\"PRO_PRT_PRY\", control.itemData(control.currentIndex));\n};\n\n// Objeto del proceso de emisión\nvar control = formulario.control(\"PRO_PRT_OBJ_ID\");\nif (control.itemData(control.currentIndex))\n{\n\ttheRegisterIn.setField(\"PRO_PRT_OBJ_ID\", control.itemData(control.currentIndex));\n};\n"},"style":0,"type":38},{"comments":"","id":"POS_INI","magicNumber":3759,"magicVer":1,"names":{},"properties":{"Lenguaje_0":0,"Script_1":""},"style":0,"subobjects":[{"comments":"","id":"7","magicNumber":37900,"magicVer":0,"names":{},"properties":{"Comando_0":23,"Desactivada_7":true,"Parámetro 1_1":"Cargar los combobox","Parámetro 2_2":"","Parámetro 3_3":"","Parámetro 4_4":"","Parámetro 5_5":"","Parámetro 6_6":""},"style":0,"type":39},{"comments":"","id":"11","magicNumber":37900,"magicVer":0,"names":{},"properties":{"Comando_0":241,"Desactivada_7":false,"Parámetro 1_1":"CAR_PRO_PRT_PRY","Parámetro 2_2":"","Parámetro 3_3":"","Parámetro 4_4":"","Parámetro 5_5":"","Parámetro 6_6":""},"style":0,"type":39},{"comments":"","id":"12","magicNumber":37900,"magicVer":0,"names":{},"properties":{"Comando_0":241,"Desactivada_7":false,"Parámetro 1_1":"CAR_PRO_PRT_OBJ","Parámetro 2_2":"","Parámetro 3_3":"","Parámetro 4_4":"","Parámetro 5_5":"","Parámetro 6_6":""},"style":0,"type":39}