 proceso = new VProcess(theRoot);\n\t\tproceso.setProcess(\"sygemat_corralon_dat/LUC_W_ACT\");\n\t\tproceso.setVar(\"ID_SES\", theApp.globalVarToString(\"sygemat_corralon_dat/CUR_ID_SES\"));\n\t\tproceso.setVar(\"EMP\", theApp.globalVarToString(\"sygemat_corralon_dat/EMP_REA_ID\"));\n\t\tproceso.setVar(\"USR\", theApp.globalVarToInt(\"sygemat_corralon_dat/CUR_USR_ID\"));\n\t\tproceso.setVar(\"LOG\", theApp.globalVarToString(\"sygemat_corralon_dat/LOG_SES\"));\n\t\tproceso.setVar(\"MAC\", theApp.globalVarToString(\"sygemat_corralon_dat/TPV_MAC\"));\n\t\tproceso.setVar(\"MAQ\", theRoot.calcFormulaVelneo(\"getSysMachineName()\"));\n\t\tproceso.setVar(\"ES_ADM\", theRoot.calcFormulaVelneo(\"sysIsAdministrator\"));\n\t\tproceso.setVar(\"FIN\", false);\n\t\tproceso.exec(VProcess.RunInServer);\n\t\tvar fin     = proceso.varToBool(\"FIN\");\n\t\tvar mensaje = proceso.varToString(\"MSG\");\n\t\ttheApp.setGlobalVar(\"sygemat_corralon_dat/LOG_SES\", \"\");\n\t\t\n\t\t// Si se recibe FIN a 1 se muestra el mensaje y se cierra la aplicación\n\t\tif (fin == true)\n\t\t{\n\t\t\ttheMainWindow.runAction(\"sygemat_corralon_app/CRR\");\n\t\t};\n\t\t\n\t\t// Se asigna al contador el valor de minutos de demora hasta el siguiente control de estado\n\t\tcontadorsets = theApp.globalVarToInt(\"sygemat_corralon_dat/LUC_MIN_CON\");\t\n\t};\n\n\t// Se decrementa el contador de sets\n\tcontadorsets--\n\ttheRoot.setVar(\"CNT_TIM\", contadorsets);\n}"},"style":0,"type":38}],"type":18}