_1":11},"style":0,"type":37},{"comments":"","id":"ACEPTAR","magicNumber":3759,"magicVer":1,"names":{},"properties":{"Lenguaje_0":1,"Script_1":"// Guardamos el modo de rebuscar seleccionado\nvar modoCombinar=theRoot.dataView().control(\"LB_MODO_COMBINAR\");\ntheRoot.setVar(\"MODO_COMBINAR\", modoCombinar.currentRow);\n\n// Guardamos la búsqueda seleccionada\nvar lbVistas=theRoot.dataView().control(\"LB_VISTAS\");\ntheRoot.setVar(\"RESULTADO\", lbVistas.currentRow);\n\n"},"style":0,"type":38},{"comments":"","id":"POST_INIT","magicNumber":3759,"magicVer":1,"names":{},"properties":{"Lenguaje_0":1,"Script_1":"#include \"(CurrentProject)/vTools/utils.js\"\n\n// Establecemos la variable de retorno a -1 para controlar si pulsan el botón Aceptar\ntheRoot.setVar(\"RESULTADO\", -1);\n\n// Añadimos los modos de búsqueda\nvar lbModoCombinar=theRoot.dataView().control(\"LB_MODO_COMBINAR\");\nlbModoCombinar.clear();\nlbModoCombinar.selectionMode=VListBox.SingleSelection;\nlbModoCombinar.addItem(tr(\"sygemat_corralon_app/CRZ\"));\nlbModoCombinar.addItem(tr(\"sygemat_corralon_app/ADD\"));\nlbModoCombinar.addItem(tr(\"sygemat_corralon_app/QUI\"));\nlbModoCombinar.currentRow=0;\n\n// JSON array con las vistas\nvar vistas=theRoot.varToString(\"VISTAS\");\nvistas=JSON.parse(vistas);\n\n\n// Añadimos las búsquedas al listbox\nvar lbVistas=theRoot.dataView().control(\"LB_VISTAS\");\nlbVistas.clear();\nfor (var i=0;i<vistas.length;i++) {\n\tlbVistas.addItem(vistas[i].title + \" (\" + vistas[i].size + \" \" + tr(\"sygemat_corralon_app/ELE\") + \")\");\n}\n\n\n"},"style":0,"type":38}],"type":18}