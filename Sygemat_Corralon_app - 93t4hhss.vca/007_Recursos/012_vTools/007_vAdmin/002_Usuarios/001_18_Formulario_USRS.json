rios existentes\nvar lb_usuarios = theRoot.dataView().control(\"lb_usuarios\");\n\nvar formUsuario = new VDataViewDialog(theRoot);\nformUsuario.setDataView(VObjectInfo.TypeForm, \"sygemat_corralon_app/USR\");\n\n// Para saber si debemos recargar la lista de usuarios\nvar refrescarListaUsuarios = false;\n\nvar origen=theSender.toString().split('\"')[1];\n\nswitch (origen) {\n\tcase \"B_AÑADIR\":\n\t\t// le indicamos al formulario que es un alta\n\t\tformUsuario.setVar(\"ID\", 0);\n\t\tif (formUsuario.exec()) {\n\t\t\trefrescarListaUsuarios = true;\n\t\t}\t\t\n\t\tbreak;\n\t\n\tcase \"B_MODIFICAR\":\n\t\t// Obtenemos el usuario seleccionado\n\t\tvar userId = lb_usuarios.itemData(lb_usuarios.currentRow);\n\t\tformUsuario.setVar(\"ID\", userId);\n\t\tif (formUsuario.exec()) {\n\t\t\trefrescarListaUsuarios = true;\n\t\t}\n\t\tbreak;\n\t\n\tcase \"B_ELIMINAR\":\n\t\tif (confirm(tr(\"sygemat_corralon_app/PRG_SUP_USR\"))) {\n\t\t\tvar userId = lb_usuarios.itemData(lb_usuarios.currentRow);\n\t\t\tvar user = new VUser();\n\t\t\tif (theServerAdmin.getUserById(userId, user)) {\n\t\t\t\tif (theServerAdmin.delUser(user))\n\t\t\t\t\trefrescarListaUsuarios = true;\n\t\t\t\telse\n\t\t\t\t\talert(tr(\"sygemat_corralon_app/ERR_SUP_USR\"));\n\t\t\t} else {\n\t\t\t\talert(tr(\"sygemat_corralon_app/ERR_LOC_USR\"));\n\t\t\t\trefrescarListaUsuarios = true;\n\t\t\t}\n\t\t}\n\t\tbreak;\n\t\n\tcase \"USRS\":\n\t\t// Estamos en el post-init\n\t\trefrescarListaUsuarios = true;\n\t\tbreak;\n}\n\n\n\nif (refrescarListaUsuarios) {\n\t// Habilitamos la ordenación del listbox\n\tlb_usuarios.sortingEnabled=true;\n\tlb_usuarios.clear();\n\t\n\t//currentUserGroups=vAdmin.user.getGroups(theApp.userName());\n\tcurrentUserGroups=vAdmin.user.getGroups(theApp.userName());\n\tvar userGroup = new VUserGroup();\n\tvar userList = new VUserList();\n\tvar uniqueUserList = new VUserList();\n\t\n\t// Cargamos todos los usuarios del servidor ya que si llegamos aquí es que somos administrador\n\tvar user = new VUser();\n\ttheServerAdmin.getUserByName(theApp.userName(), user);\n\ttheServerAdmin.getAllUsers(uniqueUserList);\n\n/*\n\t// Cargamos los usuarios de los grupos del usuario logueado\n\tfor (var i=0; i<currentUserGroups.size(); i++) {\n\t\tuserGroup = currentUserGroups.getAt(i);\n\t\tif (theServerAdmin.getUsersByGroup(userGroup, userList))\n\t\t\tuniqueUserList.append(userList);\t\t\n\t}\n*/\n\t\n\t// Añadimos la lista de usuarios de los grupos a los que pertenece el usuario actual al listbox de usuarios\n\tfor (i=0; i<uniqueUserList.size(); i++) {\n\t\tuser = uniqueUserList.getAt(i);\n\t\tlb_usuarios.addItem(user.name(), user.id());\n\t}\n\t\n\t// Habilitamos los controles en función a los usuarios de la lista\n\tvar hayUsuarioSeleccionado = (lb_usuarios.count>0) && (lb_usuarios.currentRow!=-1);\n\ttheRoot.dataView().control(\"B_MODIFICAR\").setEnabled(hayUsuarioSeleccionado);\n\ttheRoot.dataView().control(\"B_ELIMINAR\").setEnabled(hayUsuarioSeleccionado);\n}"},"style":0,"type":38},{"comments":"","id":"PRE_INI","magicNumber":3759,"magicVer":1,"names":{},"properties":{"Lenguaje_0":0,"Script_1":""},"style":0,"subobjects":[{"comments":"","id":"2","magicNumber":37900,"magicVer":0,"names":{},"properties":{"Comando_0":23,"Desactivada_7":true,"Parámetro 1_1":"Si no es un usuario administrador no se permite entrar al formulario","Parámetro 2_2":"","Parámetro 3_3":"","Parámetro 4_4":"","Parámetro 5_5":"","Parámetro 6_6":""},"style":0,"type":39},{"comments":"","id":"4","magicNumber":37900,"magicVer":0,"names":{},"properties":{"Comando_0":24,"Desactivada_7":false,"Parámetro 1_1":"sysIsAdministrator = 0","Parámetro 2_2":"","Parámetro 3_3":"","Parámetro 4_4":"","Parámetro 5_5":"","Parámetro 6_6":""},"style":0,"subobjects":[{"comments":"","id":"3","magicNumber":37900,"magicVer":0,"names":{},"properties":{"Comando_0":27,"Desactivada_7":false,"Parámetro 1_1":"~93t4hhss.vca@MSG_AUT_NO","Parámetro 2_2":"2","Parámetro 3_3":"","Parámetro 4_4":"","Parámetro 5_5":"","Parámetro 6_6":""},"style":0,"type":39},{"comments":"","id":"1","magicNumber":37900,"magicVer":0,"names":{},"properties":{"Comando_0":170,"Desactivada_7":false,"Parámetro 1_1":"","Parámetro 2_2":"","Parámetro 3_3":"","Parámetro 4_4":"","Parámetro 5_5":"","Parámetro 6_6":""},"style":0,"type":39},{"comments":"","id":"2","magicNumber":37900,"magicVer":0,"names":{},"properties":{"Comando_0":146,"Desactivada_7":false,"Parámetro 1_1":"","Parámetro 2_2":"","Parámetro 3_3":"","Parámetro 4_4":"","Parámetro 5_5":"","Parámetro 6_6":""},"style":0,"type":39}],"type":39}],"type":38},{"comments":"","id":"REFRESH_CONTROLS","magicNumber":3759,"magicVer":1,"names":{},"properties":{"Lenguaje_0":1,"Script_1":"// Obtenemos el control listbox para añadir los usuarios existentes\nvar lb_usuarios = theRoot.dataView().control(\"lb_usuarios\");\n\n// Habilitamos los controles en función a los usuarios de la lista\nvar hayUsuarioSeleccionado = (lb_usuarios.count>0) && (lb_usuarios.currentRow!=-1);\ntheRoot.dataView().control(\"B_MODIFICAR\").setEnabled(hayUsuarioSeleccionado);\ntheRoot.dataView().control(\"B_ELIMINAR\").setEnabled(hayUsuarioSeleccionado);\n\n// Si el usuario seleccionado es el actual deshabilitamos el botón eliminar\nif ((lb_usuarios.currentRow!=-1) && (lb_usuarios.itemText(lb_usuarios.currentRow)==theApp.userName())) {\n\ttheRoot.dataView().control(\"B_ELIMINAR\").setEnabled(false);\n}"},"style":0,"type":38}],"type":18}