no hay datos pero hay pestaña se elimina\n\tif ( numSubForm_Rel != -1 )\n\t{\n\t\tseparador.removeForm( numSubForm_Rel );\n\t};\n} else \n{\n\t// Si hay datos y pestaña se cambia la etiqueta, si no hay pestaña se inserta\n\tvar textoEtiqueta = \"Relaciones ( \" + numRel + \" )\";\n\tif ( numSubForm_Rel != -1 )\n\t{\n\t\tseparador.setLabelText( numSubForm_Rel, textoEtiqueta );\n\t\tposicionInsercionTab = separador.findForm( \"sygemat_corralon_app/ENT_REL_NEW\" );\n\t} else\n\t{\n\t\tseparador.insertForm( posicionInsercionTab, \"sygemat_corralon_app/ENT_REL_NEW\", textoEtiqueta );\n\t\tposicionInsercionTab = separador.findForm( \"sygemat_corralon_app/ENT_REL_NEW\" );\n\t};\t\n};\n\n// --------------------------------------------------------------------------------\n// Direcciones\n// --------------\nvar numSubForm_Dir = separador.findForm(\"sygemat_corralon_app/ENT_M_DIR\");\nif ( numDir == 0 )\n{\n\t// Si no hay datos pero hay pestaña se elimina\n\tif ( numSubForm_Dir != -1 )\n\t{\n\t\tseparador.removeForm( numSubForm_Dir );\n\t};\n} else\n{\n\t// Si hay datos y pestaña se cambia la etiqueta, si no hay pestaña se inserta\n\tvar textoEtiqueta = \"Direcciones ( \" + numDir + \" )\";\n\tif ( numSubForm_Dir != -1 )\n\t{\n\t\tseparador.setLabelText( numSubForm_Dir, textoEtiqueta );\n\t\tposicionInsercionTab = separador.findForm(\"sygemat_corralon_app/ENT_M_DIR\");\n\t} else\n\t{\n\t\tseparador.insertForm( posicionInsercionTab, \"sygemat_corralon_app/ENT_M_DIR\", textoEtiqueta );\n\t\tposicionInsercionTab = separador.findForm(\"sygemat_corralon_app/ENT_M_DIR\");\t\t\n\t};\n};\n\n// --------------------------------------------------------------------------------\n// Emails / Teléfonos\n// ---------------------\nvar numSubForm_Eml_Tfn = separador.findForm(\"sygemat_corralon_app/ENT_M_EML_TFN\");\nif ( ( numEml + numTfn ) == 0 )\n{\n\t// Si no hay datos pero hay pestaña se elimina\n\tif ( numSubForm_Eml_Tfn != -1 )\n\t{\n\t\tseparador.removeForm( numSubForm_Eml_Tfn );\n\t};\n