----------------------------------------------------------------------------\n// Tras la carga dejamos seleccionado el estado pendiente\n// --------------------------------------------------------------------------------\nvar index = combobox.findData(theRoot.varToString(\"EST\"));\n//alert(index);\ncombobox.setCurrentIndex(index);\n"},"style":0,"type":38},{"comments":"","id":"CMB_BOX_EST_LEE","magicNumber":3759,"magicVer":1,"names":{"es":"Leer la opciones seleccionada del combobox estado"},"properties":{"Lenguaje_0":1,"Script_1":"// Leer la opción seleccionada del combobox estado y guardarla en la variable local del formulario\ntheRoot.setVar(\"EST\", \"\");\nvar combobox = theRoot.dataView().control(\"EST\");\nvar itemId = combobox.itemData(combobox.currentIndex);\nif (itemId)\n{\n\ttheRoot.setVar(\"EST\", itemId);\n};\n"},"style":0,"type":38},{"comments":"","id":"ON_SHW","magicNumber":3759,"magicVer":1,"names":{},"properties":{"Lenguaje_0":0,"Script_1":""},"style":0,"subobjects":[{"comments":"","id":"21","magicNumber":37900,"magicVer":0,"names":{},"properties":{"Comando_0":23,"Desactivada_7":true,"Parámetro 1_1":"Cargar vista","Parámetro 2_2":"","Parámetro 3_3":"","Parámetro 4_4":"","Parámetro 5_5":"","Parámetro 6_6":""},"style":0,"type":39},{"comments":"","id":"13","magicNumber":37900,"magicVer":0,"names":{},"properties":{"Comando_0":241,"Desactivada_7":false,"Parámetro 1_1":"CAR_VIS","Parámetro 2_2":"","Parámetro 3_3":"","Parámetro 4_4":"","Parámetro 5_5":"","Parámetro 6_6":""},"style":0,"type":39}],"type":38},{"comments":"","id":"POS_INI","magicNumber":3759,"magicVer":1,"names":{},"properties":{"Lenguaje_0":0,"Script_1":""},"style":0,"subobjects":[{"comments":"","id":"14","magicNumber":37900,"magicVer":0,"names":{},"properties":{"Comando_0":23,"Desactivada_7":true,"Parámetro 1_1":"Inicialización de datos de búsqueda. Se asume inicialmente como período del año actual y el anterior","Parámetro 2_2":"","Parámetro 3_3":"","Parámetro 4_4":"","Parámetro 5_5":"","Par